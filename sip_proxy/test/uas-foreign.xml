<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="carrier answers 200 with a record-route that is not its own address, routable contact, takes the caller BYE">
  <recv request="INVITE" rrs="true">
    <action>
      <ereg regexp="Via: ([^[:cntrl:]]*)[[:cntrl:]]+Via: ([^[:cntrl:]]*)" search_in="msg" check_it="true" assign_to="vias,via1,via2" />
      <ereg regexp="From: ([^[:cntrl:]]*)" search_in="msg" check_it="true" assign_to="f,from" />
      <ereg regexp="To: ([^[:cntrl:]]*)" search_in="msg" check_it="true" assign_to="t,to" />
      <ereg regexp="Call-ID: ([^[:cntrl:]]*)" search_in="msg" check_it="true" assign_to="c,callid" />
      <ereg regexp="CSeq: ([^[:cntrl:]]*)" search_in="msg" check_it="true" assign_to="s,cseq" />
      <log message="carrier got [$vias] [$f] [$t] [$c] [$s]" />
    </action>
  </recv>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      Via: [$via1]
      Via: [$via2]
      From: [$from]
      To: [$to];tag=[pid]SIPpTag01[call_number]
      Call-ID: [$callid]
      CSeq: [$cseq]
      [last_Record-Route:]
      Contact: <sip:carrier@10.212.0.5:12835>
      User-Agent: mmdsip
      Content-Length: 0

    ]]>
  </send>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      Via: [$via1]
      Via: [$via2]
      From: [$from]
      To: [$to];tag=[pid]SIPpTag01[call_number]
      Call-ID: [$callid]
      CSeq: [$cseq]
      Record-Route: <sip:172.30.0.99:5060;lr>
      Contact: <sip:carrier@[local_ip]:[local_port]>
      User-Agent: mmdsip
      Server: mmdsip
      Content-Length: 0

    ]]>
  </send>
  <recv request="ACK">
    <action>
      <ereg regexp="^ACK sip:carrier@172\.30\.0\.30:5060 SIP/2\.0" search_in="msg" check_it="true" assign_to="ack_ruri" />
      <ereg regexp="^ *SIP/2\.0/UDP 172\.30\.0\.10[:;]" search_in="hdr" header="Via:" check_it="true" assign_to="ack_via" />
      <log message="carrier got the ACK [$ack_ruri] via [$ack_via]" />
    </action>
  </recv>
  <recv request="BYE">
    <action>
      <ereg regexp="^BYE sip:carrier@172\.30\.0\.30:5060 SIP/2\.0" search_in="msg" check_it="true" assign_to="bye_ruri" />
      <ereg regexp="^ *SIP/2\.0/UDP 172\.30\.0\.10[:;]" search_in="hdr" header="Via:" check_it="true" assign_to="bye_via" />
      <log message="carrier got the BYE [$bye_ruri] via [$bye_via]" />
    </action>
  </recv>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      User-Agent: mmdsip
      Content-Length: 0

    ]]>
  </send>
</scenario>
